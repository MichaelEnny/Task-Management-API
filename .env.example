DATABASE_URL=sqlite:///tasks.db
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-here

# Pagination settings (override Config defaults if needed)
# DEFAULT_PAGE_SIZE=20
# MAX_PAGE_SIZE=100

# Cache settings (uncomment when cache layer is implemented)
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=300

# Feature flags
# ENABLE_RATE_LIMITING=false
# ENABLE_TASK_NOTIFICATIONS=false
# USE_ASYNC_PROCESSING=false  # Requires Flask 3.x